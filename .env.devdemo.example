# dev.py crea .env.devdemo desde backend/.env.production si ya existe.
# Nunca sobrescribe archivos. Solo este archivo local configura el entorno nuevo.
SECRET_KEY=replace-with-a-local-random-secret
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-database-user
DB_PASSWORD=replace-me
DB_SSLMODE=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
BENEFY_DB_MODE=remote
# Opcionales: exclusivamente para provisionar cuentas de prueba con autorización.
# SUPABASE_SEED_ADMIN_KEY=
# BENEFY_DEMO_PASSWORD=
