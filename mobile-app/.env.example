# Valores públicos del proyecto Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL base de Django, sin /v1. En Docker Compose el backend se publica en 8001.
# Usa una IP LAN accesible en teléfonos físicos; localhost apunta al teléfono.
EXPO_PUBLIC_API_URL=http://192.168.1.50:8001/api

# Documentos legales públicos en texto plano UTF-8.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
