# API prevista: usar la IP LAN del equipo en dispositivos físicos.
# La plantilla App.tsx todavía no consume estas variables EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api/v1

# Google OAuth previsto, todavía sin integración; EXPO_PUBLIC_* es público.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=tu-android-client-id
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=tu-ios-client-id
