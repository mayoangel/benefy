# Valores públicos del proyecto Supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL base de Django, sin /v1. Usa una IP LAN accesible desde teléfonos físicos.
# Con `runserver` local suele ser el puerto 8000; con Docker Compose, 8001.
EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api

# Documentos legales públicos en texto plano UTF-8.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
