# Imagen de producción de Benef AI: FastAPI + Uvicorn.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=5000

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chmod +x /app/entrypoint.prod.sh \
    && addgroup --system benefai \
    && adduser --system --ingroup benefai benefai \
    && chown -R benefai:benefai /app
USER benefai

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.getenv('PORT', '5000') + '/health/live', timeout=3)"

ENTRYPOINT ["/app/entrypoint.prod.sh"]
