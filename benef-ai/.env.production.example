# Plantilla de variables para Benef AI en Railway. No contiene secretos reales.
ENVIRONMENT=production
BENEFY_LOAD_DOTENV=0
PORT=5000
WEB_CONCURRENCY=2
KEEPALIVE_TIMEOUT=5
LOG_LEVEL=INFO

# URL privada del servicio Django en Railway. Debe terminar en /api/v1.
BACKEND_API_URL=http://<backend-service>.railway.internal:8000/api/v1
BACKEND_TIMEOUT_SECONDS=10

# Autenticación interna HMAC con Django. Token de 32+ caracteres.
BENEF_AI_SERVICE_TOKEN=REEMPLAZAR_POR_TOKEN_ALEATORIO_DE_32_O_MAS_CARACTERES

# Origen(es) del portal web autorizados para CORS.
# El portal usa el proxy de Django; esta lista solo es necesaria para clientes directos.
BENEF_AI_ALLOWED_ORIGINS=

# Proveedor Gemini. La clave es opcional al arrancar; /chat responde 503 si falta.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
