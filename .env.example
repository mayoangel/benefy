# Configuración global de Docker y PostgreSQL local.
# Copia este archivo a .env solo si necesitas otros valores; compose.yaml
# ya trae estos mismos valores por defecto.
POSTGRES_USER=benefy_user
POSTGRES_PASSWORD=benefy_pass
POSTGRES_DB=benefy_db
# Reservada: compose.yaml publica 5432 en loopback (127.0.0.1) y no lee esta variable.
POSTGRES_PORT=5432
