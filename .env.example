# Copia esta plantilla a .env y configura el proyecto de demostracion.
# Para valores con $ o # usa comillas simples (sin interpolacion de Compose).
SECRET_KEY=replace-with-a-local-random-secret
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your-database-user
DB_PASSWORD=replace-me
DB_SSLMODE=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_MAX_BYTES=5242880
SUPABASE_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp
BENEFY_DB_MODE=remote
GEMINI_API_KEY=your_gemini_key

# Stripe Sandbox / Test Mode (nunca claves live).
# Deja STRIPE_ENABLED=false hasta tener claves de prueba válidas y Price IDs
# creados con: python manage.py configurar_stripe_sandbox
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcionales para vincular el catálogo durante la configuración inicial.
STRIPE_PREMIUM_PRODUCT_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Días de gracia tras un pago fallido antes de retirar Premium (0 = inmediato).
STRIPE_GRACE_DAYS=3
STRIPE_CHECKOUT_TTL_MINUTES=60
FRONTEND_URL=http://localhost:5173
# Opcionales: exclusivamente para provisionar cuentas de prueba con autorización.
# SUPABASE_SEED_ADMIN_KEY=
# BENEFY_SHOWCASE_PASSWORDS=
# Solo para pruebas aisladas con el perfil local:
LOCAL_DB_PASSWORD=replace-with-a-local-test-password
