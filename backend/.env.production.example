# Plantilla de variables para Railway. No contiene secretos reales.
# Configura estos valores en el panel del servicio; no subas un .env real.
ENVIRONMENT=production
DEBUG=False
BENEFY_LOAD_DOTENV=0
SECRET_KEY=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_50_O_MAS_CARACTERES
ALLOWED_HOSTS=api.example.com
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
LOG_LEVEL=INFO

# PostgreSQL de Supabase (usa el pooler y SSL).
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=REEMPLAZAR
DB_SSLMODE=require

# Supabase Auth y Storage.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR
SUPABASE_STORAGE_BUCKET_AVATARS=avatars
SUPABASE_STORAGE_MAX_BYTES=5242880
SUPABASE_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Portal web (CORS y CSRF). El móvil nativo no requiere CORS.
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
FRONTEND_URL=https://app.example.com

# Benef AI: URL pública HTTPS o privada de Railway. Token compartido de 32+ caracteres.
BENEF_AI_URL=https://benef-ai.example.com
BENEF_AI_SERVICE_TOKEN=REEMPLAZAR_POR_TOKEN_ALEATORIO_DE_32_O_MAS_CARACTERES
BENEF_AI_TIMEOUT_SECONDS=45
THROTTLE_BENEF_AI_CHAT=20/hour

# TLS y seguridad. Railway termina HTTPS; los health checks están exentos.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
ADMIN_ENABLED=False

# Stripe Sandbox exclusivamente.
STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRODUCT_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_GRACE_DAYS=3
STRIPE_CHECKOUT_TTL_MINUTES=60

# Límites de throttling por usuario (formato DRF).
THROTTLE_PERFIL=60/min
THROTTLE_VISITA_RESOLVER=60/min
THROTTLE_VISITA_REGISTRAR=30/min
THROTTLE_DIRECTORIO=120/min
THROTTLE_CUPON_ADQUIRIR=30/min
THROTTLE_CUPON_CANJEAR=30/min
THROTTLE_CUENTA_ELIMINAR=5/hour
