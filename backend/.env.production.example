# Variables del montaje local tipo producción (compose.demo.yaml).
# Copiar a backend/.env.production; nunca versionar el archivo real.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Session pooler de Supabase (puerto 5432).
DB_HOST=aws-1-us-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.rmwwrgahhuztylqkduya
DB_PASSWORD=

# La web, la API y el Admin comparten origen a través de Caddy.
# CORS/CSRF exigen esquema completo; añadir el hostname del túnel si se usa.
CORS_ALLOWED_ORIGINS=https://localhost
CSRF_TRUSTED_ORIGINS=https://localhost

# Cookies seguras: true con HTTPS (TLS interno de Caddy o túnel).
# Usar false solo si se accede por HTTP sin TLS en la demo local.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Proyecto Auth: URL HTTPS del proyecto, no el host PostgreSQL.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Tiempo de la pantalla de validación de canje, en segundos.
CANJE_VALIDACION_SEGUNDOS=300

# Cloudflare Tunnel (opcional, perfil "tunnel"). Vacío si no se usa.
CLOUDFLARE_TUNNEL_TOKEN=
